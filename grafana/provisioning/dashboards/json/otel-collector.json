{
  "uid": "otel-collector",
  "title": "OpenTelemetry Collector",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Received per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(otelcol_receiver_accepted_spans[1m]))",
          "legendFormat": "spans"
        },
        {
          "refId": "B",
          "expr": "sum(rate(otelcol_receiver_accepted_metric_points[1m]))",
          "legendFormat": "metric points"
        },
        {
          "refId": "C",
          "expr": "sum(rate(otelcol_receiver_accepted_log_records[1m]))",
          "legendFormat": "log records"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Sent per second, by exporter",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (exporter) (rate(otelcol_exporter_sent_spans[1m]))",
          "legendFormat": "{{exporter}} spans"
        },
        {
          "refId": "B",
          "expr": "sum by (exporter) (rate(otelcol_exporter_sent_metric_points[1m]))",
          "legendFormat": "{{exporter}} metrics"
        },
        {
          "refId": "C",
          "expr": "sum by (exporter) (rate(otelcol_exporter_sent_log_records[1m]))",
          "legendFormat": "{{exporter}} logs"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Refused / failed per second (should be 0)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(otelcol_receiver_refused_spans[1m])) + sum(rate(otelcol_receiver_failed_spans[1m]))",
          "legendFormat": "spans"
        },
        {
          "refId": "B",
          "expr": "sum(rate(otelcol_receiver_refused_log_records[1m])) + sum(rate(otelcol_receiver_failed_log_records[1m]))",
          "legendFormat": "logs"
        },
        {
          "refId": "C",
          "expr": "sum(rate(otelcol_receiver_refused_metric_points[1m])) + sum(rate(otelcol_receiver_failed_metric_points[1m]))",
          "legendFormat": "metrics"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Exporter queue size",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (exporter) (otelcol_exporter_queue_size)",
          "legendFormat": "{{exporter}}"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Collector memory (RSS)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 6,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "otelcol_process_memory_rss",
          "legendFormat": "rss"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Collector CPU",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 8,
        "w": 6,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(otelcol_process_cpu_seconds[1m])",
          "legendFormat": "cpu"
        }
      ],
      "id": 6
    }
  ]
}
