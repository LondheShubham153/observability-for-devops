{
  "uid": "host-containers",
  "title": "Host and Containers",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Host CPU %",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100",
          "legendFormat": "cpu %"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Host memory used %",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "memory %"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Host disk used %",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(100 - (node_filesystem_avail_bytes{fstype=~\"ext4|xfs|btrfs\"} / node_filesystem_size_bytes{fstype=~\"ext4|xfs|btrfs\"} * 100))",
          "legendFormat": "disk %"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Container memory (top 5)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(5, container_memory_usage_bytes{id=~\"/docker/.+\"})",
          "legendFormat": "{{id}}"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Container CPU (top 5)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(5, sum by (id) (rate(container_cpu_usage_seconds_total{id=~\"/docker/.+\"}[1m])))",
          "legendFormat": "{{id}}"
        }
      ],
      "id": 5
    },
    {
      "type": "text",
      "title": "Note",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "cAdvisor on Docker Desktop labels containers by `id` (the Docker container ID), not by name. Run `docker ps --no-trunc` to match an id to a container."
      },
      "id": 6
    }
  ]
}
