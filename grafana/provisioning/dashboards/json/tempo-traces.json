{
  "uid": "tempo-traces",
  "title": "Traces (Tempo)",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "table",
      "title": "Recent traces (all services)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "id": 1
    },
    {
      "type": "table",
      "title": "Slower traces (> 3ms, raise this for your own app)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ duration > 3ms }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "id": 2
    },
    {
      "type": "table",
      "title": "Errors (HTTP 4xx/5xx)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ span.http.status_code >= 400 }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Tempo: bytes received/s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(tempo_distributor_bytes_received_total[1m]))",
          "legendFormat": "bytes/s"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Tempo: p95 request latency",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(tempo_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "id": 5
    }
  ]
}
