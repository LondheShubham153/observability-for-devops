{
  "uid": "notes-app-red",
  "title": "Notes App (RED)",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Request rate (req/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_duration_milliseconds_count{exported_job=\"notes-app\"}[1m]))",
          "legendFormat": "requests"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Errors (4xx/5xx per second)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_duration_milliseconds_count{exported_job=\"notes-app\", http_status_code=~\"[45]..\"}[1m]))",
          "legendFormat": "errors"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Latency p95 (ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_duration_milliseconds_bucket{exported_job=\"notes-app\"}[1m])))",
          "legendFormat": "p95"
        }
      ],
      "id": 3
    },
    {
      "type": "table",
      "title": "Recent traces (click one to open it, then 'Logs for this span')",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"notes-app\" }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "id": 4
    },
    {
      "type": "logs",
      "title": "App logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"notes-app\"}"
        }
      ],
      "id": 5
    }
  ]
}
