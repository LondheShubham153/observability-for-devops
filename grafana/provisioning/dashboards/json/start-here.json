{
  "uid": "start-here",
  "title": "Start Here",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "text",
      "title": "Welcome",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**Metrics** \u2192 Prometheus \u00b7 **Logs** \u2192 Loki \u00b7 **Traces** \u2192 Tempo \u00b7 all collected by the OpenTelemetry Collector.\n\nOpen a dashboard below. New here? Read `LEARN.md`."
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Targets up",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up)",
          "instant": true
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Targets down",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(up == 0) or vector(0)",
          "instant": true
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "App requests/s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_duration_milliseconds_count{exported_job=\"notes-app\"}[1m]))",
          "instant": true
        }
      ],
      "id": 4
    },
    {
      "type": "stat",
      "title": "Spans/s into Collector",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
