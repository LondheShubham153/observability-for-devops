{
  "uid": "loki-logs",
  "title": "Logs (Loki)",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Log lines/s (all services)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(loki_distributor_lines_received_total[1m]))",
          "legendFormat": "lines/s"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Warnings and errors per minute (notes-app)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"notes-app\"} | detected_level=~\"warn|error\" [1m]))",
          "legendFormat": "warn+error"
        }
      ],
      "id": 2
    },
    {
      "type": "logs",
      "title": "All app logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\".+\"}"
        }
      ],
      "id": 3
    },
    {
      "type": "logs",
      "title": "Warnings and errors only",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\".+\"} | detected_level=~\"warn|error\""
        }
      ],
      "id": 4
    }
  ]
}
